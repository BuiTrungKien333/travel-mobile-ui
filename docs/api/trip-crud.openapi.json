        "operationId": "deleteTrip",
        "tags": [
          "Trips"
        ],
        "summary": "Soft-delete Trip and Memories; no provider calls.",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted, or repeated owner delete on an already deleted Trip."
          },
          "400": {
