              "schema": {
                "$ref": "#/components/schemas/PatchTripRequest"
              },
              "example": {
                "version": 3,
                "title": "Đà Lạt cùng gia đình",
                "budget": null,
                "notes": "Mang áo khoác"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated; no-op retains version.",
