{
  "openapi": "3.0.3",
  "info": {
    "title": "WeGo Trip CRUD - MVP contract",
    "version": "1.1.0",
    "description": "Implemented: create/list/detail/PATCH/date-impact preview/DELETE/destinations. Android/web online MVP; no draft/AI or provider calls. Province master data import and device/live e2e acceptance remain open. See TRIP-CRUD-CONTRACT.md."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Relative to configured backend origin"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Trips"
    },
    {
      "name": "Destinations"
    }
  ],
  "paths": {
    "/trips": {
      "post": {
        "operationId": "createTrip",
        "tags": [
          "Trips"
        ],
        "summary": "Create a real PLANNING trip; no AI draft.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripRequest"
              },
              "example": {
                "clientRequestId": "53e01bb8-6dbf-4368-b4f7-39289ec53913",
                "title": "Khám phá Đà Lạt",
                "destination": {
                  "name": "Đà Lạt",
                  "provinceId": null
                },
                "startDate": "2026-11-20",
                "endDate": "2026-11-22",
                "timeZone": "Asia/Ho_Chi_Minh",
                "budget": {
                  "amount": 3000000,
                  "currency": "VND"
                },
                "preferences": [
                  "nature",
                  "photography"
                ],
                "accommodation": null,
                "notes": null,
                "initialPlaceIds": []
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created with default itinerary, days and optional pool places.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Relative URL of created Trip.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "Same key/body replay: current Trip.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponse"
                }
              }
            }
          },
          "400": {
            "description": "COMMON_003/006/008 or TRIP_005: invalid input/reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_001: authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH_007: account locked or deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "TRIP_001: missing/deleted/not owned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "TRIP_002/003/004/006: stale version/date impact/key conflict/read-only state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-implementation-status": "implemented"
      },
      "get": {
        "operationId": "listTrips",
        "tags": [
          "Trips"
        ],
        "summary": "Owned non-deleted trips; mode filter before paging.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TripMode"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdAt,desc",
                "createdAt,asc",
                "updatedAt,desc",
                "updatedAt,asc",
                "startDate,desc",
                "startDate,asc"
              ],
              "default": "createdAt,desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stable page with ID tie-breaker; null startDate last.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "COMMON_003/006/008 or TRIP_005: invalid input/reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_001: authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH_007: account locked or deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-implementation-status": "implemented"
      }
    },
