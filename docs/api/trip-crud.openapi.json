    "/trips/{tripId}/date-change-preview": {
      "parameters": [
        {
          "name": "tripId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "previewTripDateChange",
        "tags": [
          "Trips"
        ],
        "summary": "Read-only date impact; no persisted preview token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DateChangeRequest"
              },
              "example": {
                "version": 3,
                "startDate": "2026-11-21",
                "endDate": "2026-11-22"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retain calendar intersection; removed items move to pool on commit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DateImpactResponse"
                }
              }
            }
          },
          "400": {
