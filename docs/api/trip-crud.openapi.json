  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Preference": {
        "type": "string",
        "enum": [
          "nature",
          "food",
          "culture",
          "relaxation",
          "photography",
          "adventure",
          "shopping",
          "beach"
        ]
      },
      "TripStatus": {
        "type": "string",
        "enum": [
          "PLANNING",
          "ACTIVE",
          "COMPLETED",
          "CANCELLED"
        ]
      },
      "TripMode": {
        "type": "string",
        "enum": [
          "PLANNING",
          "LIVE",
          "RECAP",
          "CANCELLED"
        ]
      },
      "DestinationInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provinceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "DestinationRead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "provinceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name",
          "provinceId"
        ]
      },
      "Budget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "VND"
            ]
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "nullable": true
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hasDates": {
            "type": "boolean"
          },
          "hasPlaces": {
            "type": "boolean"
          },
          "unscheduledCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "hasDates",
          "hasPlaces",
          "unscheduledCount"
        ]
      },
      "TripSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationRead"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Asia/Ho_Chi_Minh"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "mode": {
            "$ref": "#/components/schemas/TripMode"
          },
          "readiness": {
            "$ref": "#/components/schemas/Readiness"
          },
          "dayCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "stopCount": {
            "type": "integer",
            "minimum": 0
          },
          "memoryCount": {
            "type": "integer",
            "minimum": 0
          },
          "coverImageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "destination",
          "startDate",
          "endDate",
          "timeZone",
          "status",
          "mode",
          "readiness",
          "dayCount",
          "stopCount",
          "memoryCount",
          "coverImageUrl",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "TripDaySummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "dayNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "required": [
          "id",
          "date",
          "dayNumber"
        ]
      },
      "TripDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationRead"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Asia/Ho_Chi_Minh"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "mode": {
            "$ref": "#/components/schemas/TripMode"
          },
          "readiness": {
            "$ref": "#/components/schemas/Readiness"
          },
          "dayCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "stopCount": {
            "type": "integer",
            "minimum": 0
          },
          "memoryCount": {
            "type": "integer",
            "minimum": 0
          },
          "coverImageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Preference"
            },
            "maxItems": 8,
            "uniqueItems": true
          },
          "accommodation": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TripDaySummary"
            },
            "maxItems": 365
          }
        },
        "required": [
          "id",
          "title",
          "destination",
          "startDate",
          "endDate",
          "timeZone",
          "status",
          "mode",
