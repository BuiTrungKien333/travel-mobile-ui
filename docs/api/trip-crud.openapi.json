    "/destinations": {
      "get": {
        "operationId": "listDestinations",
        "tags": [
          "Destinations"
        ],
        "summary": "Internal Province catalog, not Google search.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Selected id maps to destination.provinceId.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DestinationPageResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "content": [],
                    "page": 0,
                    "size": 20,
                    "totalElements": 0,
                    "totalPages": 0,
                    "context": {
                      "serverTime": "2026-11-03T00:00:00Z",
                      "evaluatedDate": "2026-11-03"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "COMMON_003: invalid query, page or size.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_001: authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH_007: account locked or deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-implementation-status": "implemented",
        "description": "Authenticated internal Province catalog. Trim q (max 120); accent/case-insensitive Vietnamese name substring or code search. LIKE metacharacters are literal. Stable order code,id. Main migrations do not seed Province; an empty catalog is valid and free-text destination.name with provinceId=null remains supported."
      }
    }
