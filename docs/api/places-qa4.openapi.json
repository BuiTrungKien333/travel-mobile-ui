{
  "openapi": "3.0.3",
  "info": {
    "title": "WeGo QA-4 runtime: stored places and Mapbox preview",
    "version": "0.2.1",
    "description": "06/11/2026. Internal catalog/create/batch wired to mobile. Mapbox address preview backend only; SDK, provider persistence, custom/reverse/saved-locations not implemented in this increment. Google OAuth unaffected."
  },
  "servers": [
    {
      "url": "http://localhost:18081/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/places/suggestions": {
      "get": {
        "operationId": "placeSuggestions",
        "summary": "Stored INTERNAL catalog, excluding trip memberships",
        "description": "Only INTERNAL places with place_retrieval_profiles.approved=true in the selected province. No coordinate-quality gate, provider request, embedding, or AI ranking. Excludes saved trip places. Supply tripId OR provinceId; both is invalid, neither gives DESTINATION_NOT_LINKED. Trip ownership is checked before catalog lookup.",
        "parameters": [
          {
            "name": "tripId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "provinceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/SuggestionPage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/{placeId}": {
      "get": {
        "operationId": "placeDetail",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/PlaceDetail"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/addresses": {
      "get": {
        "operationId": "mapboxAddressPreview",
        "summary": "Mapbox v6 temporary address preview; disabled by default",
        "description": "Not a stored Place and cannot be passed to trip initialPlaceIds or placeIds. No persistence/cache/retry. Not a POI service. Authorization required; production request budgeting remains a release condition.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/MapboxAddressResults"
                    }
                  }
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "private, no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/places/batch": {
      "post": {
        "operationId": "addStoredTripPlaces",
        "summary": "Atomic retryable addition of stored Place UUIDs, optionally scheduled into a trip day",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "placeIds"
                ],
                "properties": {
                  "placeIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "uniqueItems": true
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "When supplied, append selected places to this editable trip day in the same transaction."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ApiResponse success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "$ref": "#/components/schemas/TripPlace"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Existing error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "code",
          "label"
        ]
      },
      "InternalReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "INTERNAL"
            ]
          },
          "placeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "placeId"
        ]
      },
      "UserReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "USER"
            ]
          },
          "placeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "placeId"
        ]
      },
      "StoredReference": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/InternalReference"
          },
          {
            "$ref": "#/components/schemas/UserReference"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "Attribution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "GOOGLE",
              "PROVIDER",
              "AUTHOR"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "nullable": true
          }
        },
        "required": [
          "kind",
          "label",
          "url"
        ]
      },
      "Photo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "source": {
            "type": "string",
            "enum": [
              "INTERNAL"
            ]
          },
          "attributions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribution"
            },
            "maxItems": 10
          }
        },
        "required": [
          "url",
          "source",
          "attributions"
        ]
      },
      "ReadContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "evaluatedDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "serverTime",
          "evaluatedDate"
        ]
      },
      "PlaceSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "$ref": "#/components/schemas/StoredReference"
          },
          "source": {
            "type": "string",
            "enum": [
              "INTERNAL",
              "USER"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "formattedAddress": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "nullable": true
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "provinceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "required": [
              "code",
              "label"
            ],
            "nullable": true
          },
          "photo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "source": {
                "type": "string",
                "enum": [
                  "INTERNAL"
                ]
              },
              "attributions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Attribution"
                },
                "maxItems": 10
              }
            },
            "required": [
              "url",
              "source",
              "attributions"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "reference",
          "source",
          "name",
          "formattedAddress",
          "location",
          "provinceId",
          "category",
          "photo"
        ]
      },
      "OpeningHours": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayLines": {
            "type": "array",
