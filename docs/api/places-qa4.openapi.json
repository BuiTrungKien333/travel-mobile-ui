          "admission": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_PROVIDED",
              "PROVIDER_UNAVAILABLE"
            ]
          },
          "photos": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_PROVIDED",
              "PROVIDER_UNAVAILABLE"
            ]
          },
          "description": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_PROVIDED",
              "PROVIDER_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "hours",
          "admission",
          "photos",
          "description"
        ]
      },
      "SuggestionPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceSummary"
