            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source": {
            "type": "string",
            "enum": [
              "INTERNAL"
            ]
          }
        },
        "required": [
          "amount",
          "currency",
          "text",
          "source"
        ]
      },
      "DataAvailability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
