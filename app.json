{
  "expo": {
    "name": "travel-mobile-ui",
    "slug": "travel-mobile-ui-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelplannermobileui",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.travel.mobile"
    },
    "android": {
      "package": "com.travel.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép WeGo dùng camera để ghi lại khoảnh khắc trong chuyến đi.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép WeGo chọn ảnh để thêm vào kỷ niệm chuyến đi.",
          "cameraPermission": "Cho phép WeGo dùng camera để ghi lại khoảnh khắc trong chuyến đi.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Cho phép WeGo lưu ảnh bạn chọn vào thư viện ảnh.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95d9d8c1-cc2e-41c3-842c-915389aaa078"
      }
    },
    "owner": "daisuki0951"
  }
}
