{
  "expo": {
    "name": "WeGo",
    "slug": "travel-mobile-ui",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/wego-icon.png",
    "scheme": "travelplannermobileui",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/wego-icon.png",
      "bundleIdentifier": "com.travel.mobile"
    },
    "android": {
      "package": "com.travel.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/wego-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wego-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/wego-splash.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép WeGo dùng camera để ghi lại khoảnh khắc trong chuyến đi.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép WeGo chọn ảnh để thêm vào kỷ niệm chuyến đi.",
          "cameraPermission": "Cho phép WeGo dùng camera để ghi lại khoảnh khắc trong chuyến đi.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Cho phép WeGo lưu ảnh bạn chọn vào thư viện ảnh.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
