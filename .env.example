# Android emulator: http://10.0.2.2:8080
# iOS simulator/web: http://localhost:8080
# Điện thoại thật: IP LAN của máy chạy backend, cùng Wi-Fi.
# Bản release phải dùng HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:8080

# true (dev default): UI fixtures without backend. false: real auth and Trip API.
# Release always uses API/auth. Restart Expo after changing this flag.
EXPO_PUBLIC_UI_PREVIEW=true

# Identifiers chosen for your app, matching Google Cloud OAuth clients.
# Required before creating native builds. Leave blank until configured.
GOOGLE_ANDROID_PACKAGE_NAME=
GOOGLE_IOS_BUNDLE_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Public Android Maps SDK key. Restrict it to this package and your build SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Web OAuth client ID is supplied by the backend challenge; no client secret in mobile.

# Opt-in only after rebuilding a client with Maps SDK support.
EXPO_PUBLIC_NATIVE_MAP_ENABLED=false
