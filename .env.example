# Dev dùng chung cho web, Android emulator và điện thoại thật.
# Android emulator tự đổi localhost thành 10.0.2.2.
# Điện thoại thật tự lấy IP máy chạy Metro (Expo LAN), cùng Wi-Fi với backend.
# Nếu backend ở máy khác hoặc dùng Expo tunnel: đặt URL LAN/HTTPS của backend trực tiếp.
# Bản release phải dùng HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Identifiers chosen for your app, matching Google Cloud OAuth clients.
# Required before creating native builds. Leave blank until configured.
GOOGLE_ANDROID_PACKAGE_NAME=
GOOGLE_IOS_BUNDLE_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web OAuth client ID is supplied by the backend challenge; no client secret in mobile.
